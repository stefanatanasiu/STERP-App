<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- ADO.NET connection used by SqlHelper (Windows authentication). -->
    <add key="STERP.Sql" value="Data Source=.;Initial Catalog=STERP;Integrated Security=SSPI" />
    <!-- ODBC string handed to the COBOL engine by sterp_init; blank = take STERP_ODBC. -->
    <add key="STERP.Odbc" value="" />
    <!-- Y writes COMMAREA hex dumps to run\logs. -->
    <add key="STERP.Trace" value="N" />
    <add key="STERP.CommandTimeout" value="120" />
  </appSettings>
</configuration>
